# Copia este archivo a .env.local y completa los valores desde tu proyecto de Supabase.
# Configuración > API en el dashboard de Supabase.

# URL del proyecto (Project URL)
SUPABASE_URL=

# Service role key (secreta). Solo se usa en el servidor (Route Handlers).
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=
